#!/bin/sh
# Full commit-profile gate (L0) before anything leaves the machine.
# Enabled by: git config core.hooksPath .githooks (scripts/bootstrap/Initialize-PbiSuperpower.ps1 does this).
if ! command -v pwsh >/dev/null 2>&1; then
    echo "[pbi] pre-push: PowerShell 7 (pwsh) is required. Install it (winget install --id Microsoft.PowerShell) or run scripts/bootstrap/Test-Prerequisites.ps1." >&2
    exit 1
fi
# PbirValidate needs the powerbi-report-author CLI; when it is not installed the check may be skipped here
# (the pull request gate still requires it).
exec pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/quality/Invoke-PbiQualityGate.ps1 -Profile commit -AllowSkip PbirValidate -NoEvidence
