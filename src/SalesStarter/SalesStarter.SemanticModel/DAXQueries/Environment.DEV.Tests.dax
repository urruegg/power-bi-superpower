// Smoke test: the Environment parameter was set for DEV (expressions.tmdl default is "Local"; deployment sets DEV/TEST/PROD).
EVALUATE
ROW (
	"TestName", "Environment parameter is DEV",
	"ExpectedValue", "DEV",
	"ActualValue", SELECTEDVALUE ( 'About'[Environment] ),
	"Passed", SELECTEDVALUE ( 'About'[Environment] ) = "DEV"
)
