			            {#date(2025, 7, 17), 5, 4, 60},
			            {#date(2025, 7, 24), 2, 2, 800},
			            {#date(2025, 8, 3), 2, 5, 800},
			            {#date(2025, 8, 10), 4, 3, 15},
