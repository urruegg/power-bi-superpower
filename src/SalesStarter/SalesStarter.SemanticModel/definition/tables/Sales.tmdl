/// Order lines (fact). One row per product per order date. Synthetic data.
table Sales

	/// Sum of Sales Amount (quantity x unit price).
	measure 'Total Sales' = SUM(Sales[Sales Amount])
		formatString: #,##0.00
		displayFolder: Sales

	/// Sum of quantity sold.
	measure 'Total Quantity' = SUM(Sales[Quantity])
		formatString: #,##0
		displayFolder: Sales

	/// Number of order lines.
	measure 'Order Lines' = COUNTROWS(Sales)
		formatString: #,##0
		displayFolder: Sales

	/// Total Sales divided by Total Quantity.
	measure 'Average Unit Price' = DIVIDE([Total Sales], [Total Quantity])
		formatString: #,##0.00
		displayFolder: Sales

	/// Total Sales from the start of the calendar year to the last date in the filter context.
	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Date'[Date])
		formatString: #,##0.00
		displayFolder: Time intelligence

	/// Total Sales for the same period one year earlier.
	measure 'Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,##0.00
		displayFolder: Time intelligence

	/// Change of Total Sales against the same period last year. Blank when there are no prior-year sales.
	measure 'Sales YoY %' =
			VAR _PriorYear = [Sales PY]
			RETURN
			    IF(NOT ISBLANK(_PriorYear), DIVIDE([Total Sales] - _PriorYear, _PriorYear))
		formatString: 0.0%
		displayFolder: Time intelligence

	column OrderDate
		dataType: dateTime
		isHidden
		formatString: Short Date
		summarizeBy: none
		sourceColumn: OrderDate

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductKey

	column Quantity
		dataType: int64
		isHidden
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: Quantity

	column 'Unit Price'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: Unit Price

	column 'Sales Amount'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: Sales Amount

	partition Sales = m
		mode: import
		source =
			let
			    // Synthetic sample data (walking skeleton). Replace with a parameterised source in Sprint 1.
			    Source = #table(
			        type table [OrderDate = date, ProductKey = Int64.Type, Quantity = Int64.Type, #"Unit Price" = Currency.Type],
			        {
			            {#date(2025, 1, 3), 1, 1, 1200},
			            {#date(2025, 1, 10), 3, 4, 90},
			            {#date(2025, 1, 17), 5, 2, 60},
			            {#date(2025, 1, 24), 2, 5, 800},
			            {#date(2025, 2, 3), 2, 3, 800},
			            {#date(2025, 2, 10), 4, 1, 15},
