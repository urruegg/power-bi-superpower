// Smoke test: the Environment parameter was set for TEST (expressions.tmdl default is "Local"; deployment sets DEV/TEST/PROD).
EVALUATE
ROW (
	"TestName", "Environment parameter is TEST",
	"ExpectedValue", "TEST",
	"ActualValue", SELECTEDVALUE ( 'About'[Environment] ),
	"Passed", SELECTEDVALUE ( 'About'[Environment] ) = "TEST"
)
