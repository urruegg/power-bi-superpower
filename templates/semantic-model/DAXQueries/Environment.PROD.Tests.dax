// Smoke test: the Environment parameter was set for PROD (expressions.tmdl default is "Local"; deployment sets DEV/TEST/PROD).
EVALUATE
ROW (
	"TestName", "Environment parameter is PROD",
	"ExpectedValue", "PROD",
	"ActualValue", SELECTEDVALUE ( 'About'[Environment] ),
	"Passed", SELECTEDVALUE ( 'About'[Environment] ) = "PROD"
)
