# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Fabric / Premium capacity display name used by DEV, TEST and PROD workspaces (leave empty for none)
PBI_CAPACITY_NAME=
# Entra group object IDs for workspace roles
PBI_DEV_ADMIN_GROUP_ID=
PBI_DEV_MEMBER_GROUP_ID=
PBI_TEST_ADMIN_GROUP_ID=
PBI_TEST_VIEWER_GROUP_ID=
PBI_PROD_ADMIN_GROUP_ID=
PBI_PROD_VIEWER_GROUP_ID=
# Optional: tenant to sign in to
PBI_TENANT_ID=
